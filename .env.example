# PostgreSQL (Neon) — use pooled URL for the app, direct URL for migrations / ETL
DATABASE_URL=
DIRECT_DATABASE_URL=

# BETTER-AUTH
BETTER_AUTH_URL=https://kyorbit.localhost
BETTER_AUTH_SECRET=

# --- Tournament realtime (main app → external Socket.io service) ---
# Server-side POST. Node cannot resolve *.localhost on Windows; use 127.0.0.1 (or localhost).
VITE_REALTIME_URL=https://ws.kyorbit.localhost
REALTIME_INTERNAL_BROADCAST_URL=http://localhost:3331/internal/broadcast
REALTIME_INTERNAL_BROADCAST_SECRET=dev-shared-secret
TOURNAMENT_SOCKET_JWT_SECRET=dev-jwt-secret-at-least-32-chars-recommended

# Static assets. Omit locally (serves public/assets). Set on production deploy.
VITE_ASSETS_URL=https://your-assets-url.com
